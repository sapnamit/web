{
  "manifest_version": 3,
  "name": "Open Assistant Sidebar",
  "description": "Injects an AI assistant sidebar on any site to talk about products, coupons, and travel.",
  "version": "0.1.0",
  "action": {
    "default_title": "Assistant",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle the assistant sidebar"
    }
  }
}