{
  "manifest_version": 3,
  "name": "Smart Shopping Assistant",
  "version": "1.0.0",
  "description": "Price comparison, auto-coupon application, and travel search assistant",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Shopping Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": ["price-panel.html", "coupon-panel.html", "travel-panel.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}